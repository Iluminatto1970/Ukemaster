# ============================================================
# UkeMaster Pro — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# ============================================================

# URL pública do site (usada em canonical, sitemap e prerender)
APP_URL="https://ukemasterpro.vercel.app"
NEXT_PUBLIC_SITE_URL="https://ukemasterpro.vercel.app"

# Supabase (acervo público, votos e repertórios)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clerk (autenticação)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Google AdSense (banners)
VITE_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"

# YouTube (busca de vídeos nas cifras) — opcional
YOUTUBE_API_KEY=""
