# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_ADSENSE_CLIENT_ID: Your Google AdSense publisher ID (e.g., ca-pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_CLIENT_ID="ca-pub-7409769323856107"

# === AIOX Variables (added 2026-08-04) ===
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Get your key at: https://exa.ai/
EXA_API_KEY=
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk (autenticação — login/cadastro dos usuários) ────────────────
# Copie de Clerk Dashboard → API Keys → Publishable key (pk_test_.../pk_live_...)
# A publishable key é PÚBLICA (fica no frontend). A secret key (sk_...) fica
# apenas no servidor — NÃO a coloque em variáveis expostas ao cliente.
VITE_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# === Supabase do UkeMaster Pro (Vite) ===
# Projeto: https://asvjdjawaenxrlwdyziy.supabase.co
# A chave pode ser a anon key (eyJ...) ou a publishable key (sb_publishable_...)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Nomes alternativos (padrão Next.js) — o vite.config.ts expõe ambos os prefixos
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ── Supabase (banco de dados do UkeMaster Pro) ────────────────────────
# Copie de Supabase → Project Settings → API:
#   Project URL        → VITE_SUPABASE_URL
#   anon public key    → VITE_SUPABASE_ANON_KEY
# Cole no .env.local (e nas Environment Variables da Vercel) para ligar
# a sincronização em nuvem (acervo público, playlists, repertórios e leads).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# === Analytics (opcional — GA4 e/ou Plausible) ===
# Basta preencher UMA das duas para ativar. Sem nenhuma, o app não envia nada.
#
# ── Google Analytics 4 (GRÁTIS) ──
# 1. analytics.google.com → "Iniciar medição" → criar propriedade "UkeMaster Pro"
# 2. Web → URL do site (https://ukemasterpro.vercel.app)
# 3. Na tela seguinte, copie o ID de medição (formato G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
#
# ── Plausible (leve/privacy-first; 14 dias grátis, depois ~US$9/mês) ──
# 1. plausible.io → New Site → adicione ukemasterpro.vercel.app
# 2. Copie o domínio que aparece no script (data-domain)
# ⚠ Os eventos custom (song_view, song_vote...) exigem plano PAGO; no
#   trial só as pageviews contam. O GA4 é grátis e rastreia tudo.
VITE_PLAUSIBLE_DOMAIN=
# Host do Plausible (padrão plausible.io; mude se auto-hospedar)
VITE_PLAUSIBLE_API_HOST=plausible.io
#
# Eventos rastreados: song_view, song_vote, song_unvote, signup_start,
# login_start, lead_captured, tab_view + page_views por tela.
#
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=
# Sentry (error tracking)
SENTRY_DSN=
# Railway (deployment)
RAILWAY_TOKEN=
# Vercel (deployment)
VERCEL_TOKEN=
# --------------------------------------------
NODE_ENV=development
AIOX_VERSION=5.3.0
