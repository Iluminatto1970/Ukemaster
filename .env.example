# ============================================================
# UkeMaster Pro — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite segredos reais (o .env.local é gitignored).
# ============================================================

# URL pública do site (usada em canonical, sitemap e prerender)
APP_URL="https://ukemasterpro.vercel.app"
NEXT_PUBLIC_SITE_URL="https://ukemasterpro.vercel.app"

# ── Supabase (acervo público, votos, repertórios E autenticação) ──
# Crie em: supabase.com → Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""   # anon/publishable (pública, vai no bundle)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""          # mesmo valor do publishable

# ── MCP Supabase (ferramentas dos agentes — opcional, ver .mcp.json) ──
# Gere em: supabase.com → Account → Access Tokens (prefixo sbp_)
SUPABASE_ACCESS_TOKEN=""
SUPABASE_PROJECT_REF="xxxx"

# ── Segurança das rotas administrativas (scrape/cron) ─────────────
# Fail-closed em produção: SEM esse valor os endpoints admin negam 403.
# Gere com: node -e "console.log('adm_' + require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=""
# E-mail do proprietário (único autorizado a excluir músicas / admin)
ADMIN_EMAIL="iluminatto@gmail.com"

# Google AdSense (banners)
VITE_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"

# YouTube (busca de vídeos nas cifras) — opcional
YOUTUBE_API_KEY=""

# Google OAuth (login com Google) — usado na configuração do Supabase
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
