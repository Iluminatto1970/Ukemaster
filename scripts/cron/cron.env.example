# ── UkeMaster Pro — env do cron de plataformas ────────────────────────────
# O instalador (scripts/cron/install.sh) copia este arquivo para
# dist-cron/.env automaticamente (preenchendo as chaves do .env.local se
# existir). Só são necessárias 2 variáveis — chaves públicas por design.

# URL do seu projeto Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publishable/anon do Supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-aqui

# ── Conta UkeMater (obrigatória desde 2026-08) ───────────────────────────
# O cron escreve autenticado como o usuário UkeMater do Supabase Auth (não
# usa mais o papel anônimo). Configure a MESMA conta em todas as máquinas e
# na Vercel (CRON_UKEMATER_EMAIL / CRON_UKEMATER_PASSWORD nas env vars do
# projeto). Sem estas vars o cron degrada para a anon key e passa a falhar
# depois da migration-ukemater-cron.sql (que exige login nas escritas).
CRON_UKEMATER_EMAIL=ukemater@ukemasterpro.com.br
CRON_UKEMATER_PASSWORD=

# ── Opcionais ─────────────────────────────────────────────────────────────

# Orçamento por execução (ms). 900000 = 15 minutos.
# Em máquinas locais NÃO há o limite de 60s da Vercel, então pode ser
# generoso: quanto maior, mais artistas por rodada (até sincronizar tudo).
CRON_TIME_BUDGET_MS=900000

# DIVISÃO POR MÁQUINA (opcional): restringe esta máquina a SÓ as plataformas
# listadas (separadas por vírgula). Ideal para dividir o trabalho entre as
# máquinas do proprietário sem disputar o lease:
#   Acer    → CRON_PLATFORMS=cifraclub-br,ufret-ja
#   Windows → CRON_PLATFORMS=ukutabs-en,guitaretab-int
# Vazio (padrão) = processa TODAS as plataformas habilitadas.
# Ids disponíveis: cifraclub-br, ukutabs-en, ufret-ja, guitaretab-int
CRON_PLATFORMS=

# Para rodar mais devagar (mais educado com o site de origem), reduza o
# orçamento ou desligue o modo automático e rode manualmente com --artist.

# ── Enriquecimento com VÍDEO (opcional) ───────────────────────────────────
# Sem esta chave, o cron NÃO busca vídeos (zero custo).
# Com ela, cada execução busca a videoaula do YouTube (máx. 20 músicas/rodada)
# e grava youtube_id — os cards passam a mostrar thumbnail real.
# Crie a chave grátis: console.cloud.google.com → APIs & Services →
# habilitar "YouTube Data API v3" → Credentials → API key.
# Cota grátis: ~10.000 unidades/dia (cada busca = 100) — suficiente.
YOUTUBE_API_KEY=
